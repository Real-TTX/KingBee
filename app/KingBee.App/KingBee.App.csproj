<Project Sdk="Microsoft.NET.Sdk">

  <!--
    King Bee as a Windows app: the MatGame shell (WebView2) with the built client embedded (npm run build first: server/KingBee.Module/wwwroot).
    Offline play needs no server logic (the simulation runs in the browser part); online it plays against a MatGame master (default MatGameDefaultServer).
    Publish: dotnet publish app/KingBee.App -c Release -r win-x64 (one self-installing exe, see MatGame.Shell.Installer).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- builds on the Linux runners too (the solution build); runs on Windows only -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>KingBee</AssemblyName>
    <RootNamespace>KingBee.App</RootNamespace>
    <ApplicationIcon>kingbee.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="MatGameDefaultServer" Value="$(MatGameDefaultServer)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\MatGame\src\MatGame.Shell\MatGame.Shell.csproj" />
  </ItemGroup>

  <!-- the built browser part: server/KingBee.Module/wwwroot → web/kingbee/... (served at https://kingbee.matgame.invalid/kingbee/) -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\server\KingBee.Module\wwwroot\**" LogicalName="web/kingbee/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="KingBeeNeedsClientBuild" BeforeTargets="PrepareForBuild" Condition="!Exists('..\..\server\KingBee.Module\wwwroot\index.html')">
    <Error Text="Der Client ist nicht gebaut: zuerst 'npm ci' und 'npm run build' im KingBee-Ordner." />
  </Target>

  <Import Project="..\..\..\MatGame\src\MatGame.Shell\MatGame.Shell.targets" />

</Project>
